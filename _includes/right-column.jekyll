<div class="where">
  このブログは<a href="https://jekyllrb.com/">Jekyll</a>で構築されてて、ソースコードは<a href="https://github.com/wp041/wp041.github.io">ここ</a>で見ることができます。
  {% comment %} リポジトリをprivateにするとデプロイ止まる（一負） {% endcomment %}
  <br/>
  最終更新日：{{ site.time | date: "%Y-%m-%d" }}
  <br/>
  <br/>
  <a href="/feed.xml">RSSフィード</a>（登録すると通知が届く）
  <br>
  <br>
  <a href="https://forms.gle/nMtQC3BNt77DnyhB7">ご意見・ご感想（匿名）</a>
  <br/>
</div>
<div class="random">
  新着テキスト↓
  <br/>
  <br/>
  {% assign memo_posts = site.posts | where_exp: "post", "post.tags contains 'memo'" %}
  {% for post in memo_posts limit: 1 %}
    <div class="random-content">
      <h2>
        <a href="{{ post.url | relative_url }}" class="random-title">{{ post.title }}</a>
      </h2>
      <br/>
      {{ post.excerpt }}
      <br/>
    </div>
    ({{ post.date | date: "%Y-%m-%d" }})
  {% endfor %}
  <a href="{{ '/memo' | relative_url }}">もっとみる⤴</a>
</div>